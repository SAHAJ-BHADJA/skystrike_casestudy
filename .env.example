# Copy to `.env` and fill in. All values are optional — the app runs on bundled
# sample data when no API key is present, so a reviewer can start it with zero setup.

# JamBase Concert Data API key (Bearer token). Get a free 14-day trial key at
# https://data.jambase.com/api/docs/getting-started
JAMBASE_API_KEY=

# Cache time-to-live in seconds. Event searches are cached to cut duplicate
# upstream calls; geography lookups (city/metro IDs) are cached far longer.
CACHE_TTL_SECONDS=300
GEO_CACHE_TTL_SECONDS=86400

# Upstream resilience knobs.
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
